# Copy this file to .env and fill in your real values. Never commit .env.

# --- Anthropic (analysis brain) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: leave unset to use the official Anthropic API. Set this to point
# at an alternative endpoint instead, e.g. AgentRouter:
# ANTHROPIC_BASE_URL=https://agentrouter.org
# If set, ANTHROPIC_API_KEY should be the token for that service instead.

# --- Market data ---
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
NEWSAPI_KEY=your_newsapi_key
# CoinGecko free tier needs no key

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# --- Email (reuse your existing SMTP setup if you have one) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
ALERT_EMAIL_TO=your_email@example.com

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_TO_NUMBER=+233xxxxxxxxx
